{
  "name": "offlineseal-web",
  "private": true,
  "version": "0.1.0",
  "description": "OfflineSeal Web: browser-enforced local file processing. The tool can have the internet, or it can have your file, never both.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "serve": "node build.mjs && node server/serve.mjs",
    "test": "node build.mjs && node --test --test-concurrency=4 'test/unit/*.test.mjs' 'test/e2e/*.test.mjs'",
    "test:unit": "node build.mjs && node --test 'test/unit/*.test.mjs'",
    "test:e2e": "node build.mjs && node --test --test-concurrency=4 'test/e2e/*.test.mjs'",
    "test:edge": "node build.mjs && OFFLINESEAL_BROWSER=msedge node --test --test-concurrency=4 'test/e2e/*.test.mjs'",
    "evidence": "node scripts/capture-evidence.mjs"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1",
    "playwright": "1.56.1"
  }
}
